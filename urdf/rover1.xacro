<?xml version="1.0"?>
<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ======================= Materials ======================= -->
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="blue"><color rgba="0 0 1 1"/></material>
  <material name="red"><color rgba="1 0 0 1"/></material>
  <material name="yellow"><color rgba="1 1 0 1"/></material>
  <material name="green"><color rgba="0 1 0 1"/></material>

  <!-- ======================= Chassis ======================= -->
  <link name="chassis">
    <visual>
      <geometry><box size="0.6 0.4 0.08"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.6 0.4 0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="10"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.5"/>
    </inertial>
  </link>
  <gazebo reference="chassis"><material>Gazebo/Blue</material></gazebo>

  <!-- ======================= Wheel Macro ======================= -->
  <xacro:macro name="wheel" params="name x y driven">
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="0.08" length="0.04"/></geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.08" length="0.04"/></geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <surface><friction><ode mu="0.1" mu2="0.1"/></friction></surface>
      </collision>
      <inertial>
        <mass value="1"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="chassis"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} -0.075" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <gazebo reference="${name}">
      <material>Gazebo/Black</material>
      <mu1>0.4</mu1>
      <mu2>0.4</mu2>
      <kp>100000.0</kp>
      <kd>1.0</kd>
      <fdir1>1 0 0</fdir1>
      <maxVel>3</maxVel>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>

  <!-- ======================= Wheels Placement ======================= -->
  <xacro:wheel name="front_left_wheel"  x="0.25"  y="0.23" driven="false"/>
  <xacro:wheel name="front_right_wheel" x="0.25"  y="-0.23" driven="false"/>
  <xacro:wheel name="rear_left_wheel"   x="-0.25" y="0.23" driven="true"/>
  <xacro:wheel name="rear_right_wheel"  x="-0.25" y="-0.23" driven="true"/>

  <!-- ======================= Diff Drive Plugin ======================= -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <robotNamespace>/rover</robotNamespace>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <leftJoint>rear_left_wheel_joint</leftJoint>
      <rightJoint>rear_right_wheel_joint</rightJoint>
      <wheelSeparation>0.40</wheelSeparation>
      <wheelDiameter>0.16</wheelDiameter>
      <robotBaseFrame>chassis</robotBaseFrame>
      <odometryFrame>odom</odometryFrame>
      <publishWheelTF>true</publishWheelTF>
      <publishOdomTF>true</publishOdomTF>
      <publishWheelJointState>true</publishWheelJointState>
      <updateRate>50.0</updateRate>
      <torque>10.0</torque>
      <wheelAcceleration>2.0</wheelAcceleration>
      <wheelTorque>6.0</wheelTorque>
    </plugin>
  </gazebo>

 <!-- ================= ULTRASONIC SENSOR ================= -->

 <link name="ultrasonic_link">
  <visual>
    <origin xyz="0 0 0" rpy="6.28318 6.28318 4.7124 "/>
    <geometry>
      <mesh filename="package://rover_control/meshes/ultrasonic.dae"
            scale="0.0025 0.0025 0.0025  "/>
    </geometry>
  </visual>

    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.0005" iyy="0.0005" izz="0.0005"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="ultrasonic_joint" type="fixed">
    <parent link="chassis"/>
    <child link="ultrasonic_link"/>
    <origin xyz="0.3 0.05 0.05"/>
  </joint>

  <gazebo reference="ultrasonic_link">
    <sensor type="ray" name="ultrasonic_sensor">
      <update_rate>20</update_rate>
      <ray>
        <range>
          <min>0.02</min>
          <max>3.0</max>
        </range>
      </ray>

      <plugin name="ultra_plugin" filename="libgazebo_ros_range.so">
        <robotNamespace>/rover</robotNamespace>
        <topicName>ultrasonic</topicName>
        <frameName>ultrasonic_link</frameName>
        <radiation>ultrasound</radiation>
        <fov>0.5</fov>
        <gaussianNoise>0.0</gaussianNoise>
        <updateRate>20</updateRate>
      </plugin>
    </sensor>
  </gazebo>
  
   <!-- ======================= IMU Sensor ======================= -->
  <link name="imu_link">
    <visual>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry>
      <mesh filename="package://rover_control/meshes/MPU6050 v2.dae"
            scale="0.0025 0.0025 .0025  "/>
    </geometry>
      <material name="green"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="0.2 0.06 0.05"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <noise>
        <type>gaussian</type>
        <rate>0.0</rate>
      </noise>

      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <robotNamespace>/rover</robotNamespace>
        <topicName>imu</topicName>
        <frameName>imu_link</frameName>
        <updateRateHZ>50</updateRateHZ>
        <gaussianNoise>0.0</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
      </plugin>
    </sensor>
  </gazebo>


</robot>
